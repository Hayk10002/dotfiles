// -*- mode: jsonc -*-
{
    "layer": "bottom", 
    "height": 30,
    "spacing": 20, // Gaps between modules (4px)
	"reload_style_on_change": true,
    
    "modules-right": [
        "inhibitor",
        "memory",
        "group/disks", 
        "temperature",
        "cpu",
        "pulseaudio",
        "bluetooth",
        "network",
        "backlight",
        "battery",
        "hyprland/language",
        "clock",
        "custom/power"
    ],
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/workspaces#windows",
    ],
    "modules-center": [
    ],
    // "tray": {
    //     // "icon-size": 21,
    //     "spacing": 10,
    //     // "icons": {
    //     //   "blueman": "bluetooth",
    //     //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
    //     // }
    // },
    "clock": {
        "interval": 1,
        "format": "{:%H:%M:%S}",
        "tooltip-format": "{:%d-%m-%Y}"
    },
    "cpu": {
        "interval": 1,
        "format": "{usage}% "
    },
    "temperature": {
        "interval": 1,
        "thermal-zone": 13,
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "CPU"
    },
    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "reverse-scrolling": true
    },
    "battery": {
        "interval": 1,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% {icon}󱐋",
        "format-warning": "{capacity}% {icon}!",
        "format-critical": "{capacity}% {icon}‼",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "Cycles: {cycles}\nHealth: {health}",
        "tooltip-format-charging": "Time till full: {time}\nPower: {power}\nCycles: {cycles}\nHealth: {health}",
        "events": {
            "on-discharging-warning": "notify-send 'Battery' 'Low battery'",
            "on-discharging-critical": "notify-send -u critical 'Battery' 'Very low battery'",
            "on-charging-98": "notify-send 'Battery' 'Battery full'"
        }
    },
    "bluetooth": {
        "format-no-controller": "",
        "format-disabled": "󰂯❌",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱",
        "format-connected-battery": "{device_battery_percentage}% 󰂱",
        "tooltip-format-disabled": "Status: Disabled\nAdapter: {controller_alias}",
        "tooltip-format-off": "Status: Powered off\nAdapter: {controller_alias}",
        "tooltip-format-on": "Status: Powered on\nAdapter: {controller_alias}",
        "tooltip-format-connected": "Status: Connected\nDevices:\n{device_enumerate}\nAdapter: {controller_alias}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "  {device_alias}: {device_battery_percentage}%",
        "on-click": "kitty bluetuith"
    },
    // "power-profiles-daemon": {
    //   "format": "{icon}",
    //   "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    //   "tooltip": true,
    //   "format-icons": {
    //     "default": "",
    //     "performance": "",
    //     "balanced": "",
    //     "power-saver": ""
    //   }
    // },
    "network": {
        "interval": 2,
        "format-disabled": "󰣽",
        "format-disconnected": "󰤮",
        "format-ethernet": "",
        "format-wifi": "{icon}",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-disabled": "Disabled",
        "tooltip-format-disconnected": "Disconnected",
        "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}/{cidr}\n\nUpload: {bandwidthUpBytes}\nDownload: {bandwidthDownBytes}",
        "tooltip-format-wifi": "Name: {essid}\nIP: {ipaddr}/{cidr}\n\nUpload: {bandwidthUpBytes}\nDownload: {bandwidthDownBytes}",
        "format-linked": "{ifname} (No IP)",
        "on-click": "kitty impala"
    },
    "group/disks": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": false
        },
        "modules": ["disk", "disk#timeshift"]
    },
    "disk": {
        "interval": 10,
        "format": "{percentage_used}% ☰"
    },
    "disk#timeshift": {
        "interval": 10,
        "path": "/mnt/timeshift",
        "format": "{percentage_used}% ☰"
    },
    "hyprland/language": {
        "format-en": "ENG",
        "format-ru": "РУС",
        "format-hy": "ՀԱՅ"
    },
    "hyprland/workspaces": {
        // "format-icons": {
        //     "default": "○",
        //     "active": "●",
        //     "urgent" : "!",
        // }
    },
    "hyprland/workspaces#windows": {
        "format": "{windows}",
        "active-only": true,
        "update-active-window": true,
        "workspace-taskbar": {
            "enable": true,
            "update-active-window": true,
        }
    },
    "memory": {
        "interval": 10,
        "format": "{percentage}% ",
        "tooltip-format": "RAM: {used:0.1f}GB/{total:0.1f}GB\nSwap: {swapUsed:0.1f}GB/{swapTotal:0.1f}GB\nSwap state: {swapState}",
    },
    "pulseaudio": {
        "scroll-step": 1, // %
        "reverse-scrolling": true,
        "format": "{volume}% {icon} {format_source}",
        "format-muted": "{icon} {format_source}",
        "format-source": "{volume}% 󰍬",
        "format-source-muted": "󰍭",
        "format-icons": {
            "headphone": "󰋋",
            "headphone-muted": "󰟎",
            "default": ["󰕿", "󰖀", "󰕾"],
            "default-muted": ["󰖁"]
        },
        "on-click": "pavucontrol"
    },
    "inhibitor": {
        "what": ["handle-lid-switch", "sleep"],
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "custom/power": {
        "format": "⏻",
        "menu": "on-click",
        "menu-file": "~/.config/waybar/gtk-menus/power-menu.xml",
        "menu-actions": {
            "lock": "loginctl lock-session",
            "logoff": "hyprctl dispatch \"hl.dsp.exec_cmd(\\\"hyprshutdown\\\")\"",
            "suspend": "systemctl suspend",
            "hibernate": "systemctl hibernate",
            "shutdown": "hyprctl dispatch \"hl.dsp.exec_cmd(\\\"hyprshutdown -p 'systemctl poweroff'\\\")\"",
            "reboot": "hyprctl dispatch \"hl.dsp.exec_cmd(\\\"hyprshutdown -t 'Restarting...' -p 'systemctl reboot'\\\")\""
        },
    }
}

